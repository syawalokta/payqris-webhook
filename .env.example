# ==========================================
# PayQRIS Webhook Receiver Configuration
# Website: https://payqris.id
# Docs: https://payqris.id/docs#webhooks
# ==========================================

# Webhook Secret Anda dari Dashboard PayQRIS (https://payqris.id/dashboard -> Menu Webhook Settings)
WEBHOOK_SECRET=your_payqris_webhook_secret_here

# Port untuk menjalankan server lokal / VPS (default: 3000)
PORT=3000

# ==========================================
# Integrasi Opsional (Bisa dikosongkan jika tidak dipakai)
# ==========================================

# Forward URL: Forward webhook ke backend internal / bot webhook lain
# Contoh: https://mywebsite.com/api/payment-callback
FORWARD_URL=

# Notifikasi Telegram Bot (jika ingin diteruskan ke Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
